# Copy to .env for local development. Never commit .env.
HABITUDE_DATABASE_URL=sqlite:///./habitude.db
HABITUDE_SESSION_TTL_DAYS=30
HABITUDE_CORS_ORIGINS=["http://localhost:5173"]
HABITUDE_LOG_LEVEL=INFO
# Set to true when served over HTTPS so the session cookie gets the Secure flag.
HABITUDE_COOKIE_SECURE=false
