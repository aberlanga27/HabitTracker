      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ScheduleIn": {
        "description": "A schedule rule; fields irrelevant to `type` are ignored (FR-002, FR-003).",
        "properties": {
          "times_per_week": {
            "anyOf": [
              {
                "maximum": 7.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Times Per Week"
          },
          "type": {
            "enum": [
              "daily",
              "weekdays",
              "times_per_week"
            ],
            "title": "Type",
            "type": "string"
          },
          "weekdays": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weekdays"
          }
        },
        "required": [
          "type"
        ],
        "title": "ScheduleIn",
        "type": "object"
      },
      "ScheduleRead": {
        "properties": {
          "effective_from": {
            "format": "date",
            "title": "Effective From",
            "type": "string"
          },
          "times_per_week": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Times Per Week"
          },
          "type": {
            "enum": [
              "daily",
              "weekdays",
              "times_per_week"
            ],
            "title": "Type",
            "type": "string"
          },
          "weekdays": {
            "items": {
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ],
              "type": "string"
            },
            "title": "Weekdays",
            "type": "array"
          }
        },
        "required": [
          "type",
          "weekdays",
          "times_per_week",
          "effective_from"
        ],
        "title": "ScheduleRead",
        "type": "object"
      },
      "UserRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "timezone",
          "created_at"
