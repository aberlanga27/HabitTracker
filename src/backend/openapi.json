            "type": "array"
          }
        },
        "required": [
          "date",
          "items"
        ],
        "title": "DaySummary",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
