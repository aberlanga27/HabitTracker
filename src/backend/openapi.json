                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "habit_id": {
            "title": "Habit Id",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "habit_id",
          "date",
          "completed",
          "note",
          "completed_at"
        ],
        "title": "CheckInState",
        "type": "object"
      },
      "DayHabit": {
        "properties": {
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "habit": {
            "$ref": "#/components/schemas/HabitRead"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
