              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HabitCreate": {
        "properties": {
          "color": {
            "default": "coral",
            "enum": [
              "coral",
              "amber",
              "lime",
              "teal",
              "sky",
              "indigo",
              "violet",
              "rose"
            ],
            "title": "Color",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/ScheduleIn"
          }
        },
        "required": [
          "name"
        ],
        "title": "HabitCreate",
        "type": "object"
      },
      "HabitList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/HabitRead"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "HabitList",
        "type": "object"
      },
      "HabitOrder": {
        "properties": {
          "habit_ids": {
            "items": {
              "type": "string"
            },
            "title": "Habit Ids",
            "type": "array"
          }
        },
        "required": [
          "habit_ids"
        ],
        "title": "HabitOrder",
        "type": "object"
      },
      "HabitRead": {
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "color": {
            "enum": [
              "coral",
              "amber",
              "lime",
              "teal",
              "sky",
              "indigo",
              "violet",
              "rose"
            ],
            "title": "Color",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "schedule": {
            "$ref": "#/components/schemas/ScheduleRead"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "color",
          "position",
          "archived_at",
          "created_at",
          "schedule"
        ],
        "title": "HabitRead",
        "type": "object"
      },
      "HabitUpdate": {
        "description": "Partial update; omitted fields are unchanged, null clears description or icon.",
        "properties": {
          "color": {
            "anyOf": [
              {
                "enum": [
                  "coral",
                  "amber",
                  "lime",
                  "teal",
                  "sky",
                  "indigo",
                  "violet",
                  "rose"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
